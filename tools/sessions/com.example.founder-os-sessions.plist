<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A launchd job that recompiles the sessions room every five minutes while you are logged in.
       Install: copy this file to ~/Library/LaunchAgents/, change the folder on the WorkingDirectory
       line to wherever this repo lives, then run
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.founder-os-sessions.plist
       Remove with launchctl bootout gui/$(id -u)/com.example.founder-os-sessions
       Logs land in ~/Library/Logs/founder-os/sessions.log. launchd does not expand ~ in paths, which is
       why the job runs through sh and uses $HOME. -->
  <key>Label</key>
  <string>com.example.founder-os-sessions</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>mkdir -p "$HOME/Library/Logs/founder-os" &amp;&amp; exec /usr/bin/python3 compile_sessions.py >> "$HOME/Library/Logs/founder-os/sessions.log" 2>&amp;1</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/founder-os-starter/tools/sessions</string>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
